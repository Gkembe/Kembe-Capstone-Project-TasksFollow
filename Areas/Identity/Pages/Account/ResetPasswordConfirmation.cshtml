@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password Updated";
}

<div class="container d-flex justify-content-center align-items-center py-5">
    <div class="card shadow-sm border-0 w-100" style="max-width: 480px;">
        <div class="card-body p-4 p-md-5 text-center">

            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>

            <h2 class="fw-bold mb-3">Password Updated Successfully!</h2>
            <p class="text-muted mb-4">
                Your password has been successfully set or updated.
                You can now log in to your TasksFollow account using your email and password.
            </p>

            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Go to Login
            </a>

            <p class="text-muted small mt-4 mb-0">
                Welcome to TasksFollow - Manage your projects and tasks efficiently.
            </p>

        </div>
    </div>
</div>
