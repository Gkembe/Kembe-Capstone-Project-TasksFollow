@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<!-- Login page -->
<div class="login-page">
    <div class="login-container">

        <!-- Application branding -->
        <div class="login-brand">
            <div class="login-brand-icon"><i class="bi bi-check2-square"></i></div>
            <h1>TasksFollow</h1>
            <p>Manage projects. Track tasks. Achieve more.</p>
        </div>

        <!-- Login form card -->
        <div class="login-card">
            <div class="login-card-header">
                <h2>Welcome Back!</h2>
                <p>Sign in to access your workspace.</p>
            </div>

            <form id="account" method="post">

                <!-- Display login errors -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- Email address -->
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email Address</label>
                    <div class="login-input">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email address" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <div class="login-input">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Remember me and password recovery -->
                <div class="login-options">
                    <label class="login-remember">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        Remember me
                    </label>
                    <a asp-page="./ForgotPassword">Forgot password?</a>
                </div>

                <!-- Submit login -->
                <button id="login-submit" type="submit" class="btn login-submit">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <!-- External login providers, if configured -->
            @if (Model.ExternalLogins != null && Model.ExternalLogins.Count > 0)
            {
                <div class="login-external">
                    <p>Or continue with</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }
        </div>

        <!-- Return to home page -->
        <div class="login-back">
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Back to Home</a>
        </div>

        <p class="login-copyright">&copy; @DateTime.Now.Year TasksFollow. All rights reserved.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
