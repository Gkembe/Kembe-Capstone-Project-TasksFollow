@model TasksFollow.Models.Message

@{
    ViewData["Title"] = "Edit Message";
    Layout = User.IsInRole("Manager") ? "_ManagerLayout" : "_EmployeeLayout";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Edit Message</h2>
            <p class="text-muted mb-0">Update your message in this conversation.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.GroupChatId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Conversation
        </a>
    </div>

    <!-- Edit Message Form -->
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="EditMessage" asp-route-id="@Model.MessageId" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="content" class="form-label">Message</label>
                    <textarea id="content" name="content" class="form-control" rows="5" maxlength="3000" required>@Model.Content</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.GroupChatId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
