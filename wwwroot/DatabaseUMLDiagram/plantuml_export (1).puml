@startuml
title TasksFollow - Database UML Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

' =====================================================
' TABLES / CLASSES
' =====================================================

class ApplicationUser {
    + Id : string
    + CompanyId : int?
}

class Company {
    + CompanyId : int
}

class Employee {
    + EmployeeId : int
    + CompanyId : int
    + ApplicationUserId : string
}

class Project {
    + ProjectId : int
    + CompanyId : int
    + CreatedByUserId : string
}

class ProjectTask {
    + ProjectTaskId : int
    + ProjectId : int
    + CreatedByUserId : string
}

class ProjectMember {
    + ProjectMemberId : int
    + ProjectId : int
    + EmployeeId : int
}

class TaskAssignment {
    + TaskAssignmentId : int
    + ProjectTaskId : int
    + EmployeeId : int
}

class Comment {
    + CommentId : int
    + ProjectTaskId : int
    + ParentCommentId : int?
}

class GroupChat {
    + GroupChatId : int
    + CompanyId : int
    + CreatedByUserId : string
}

class GroupMember {
    + GroupMemberId : int
    + GroupChatId : int
    + EmployeeId : int
}

class Message {
    + MessageId : int
    + GroupChatId : int?
    + ParentMessageId : int?
}

class SubscriptionPlan {
    + SubscriptionPlanId : int
    + Name : string
    + Description : string
    + MonthlyPrice : decimal?
    + IsActive : bool
}

class Payment {
    + PaymentId : int
    + CompanyId : int
    + SubscriptionPlanId : int
    + AmountPaid : decimal
    + MonthlyPrice : decimal
    + MonthsPaid : int
    + PaymentDate : DateTime
    + CoverageStartDate : DateTime
    + CoverageEndDate : DateTime
}


' =====================================================
' COMPANY / WORKSPACE
' =====================================================

Company "1" -- "0..*" ApplicationUser : has users

Company "1" -- "0..*" Employee : has employees

Company "1" -- "0..*" Project : has projects

Company "1" -- "0..*" GroupChat : has groups

Company "1" -- "0..*" Payment : makes payments


' =====================================================
' APPLICATION USER / EMPLOYEE
' =====================================================

ApplicationUser "1" -- "0..1" Employee : Employee profile


' =====================================================
' PROJECT
' =====================================================

ApplicationUser "1" -- "0..*" Project : creates

Project "1" -- "0..*" ProjectMember : has members

Employee "1" -- "0..*" ProjectMember : joins projects


' =====================================================
' PROJECT TASK
' =====================================================

Project "1" -- "0..*" ProjectTask : contains

ApplicationUser "1" -- "0..*" ProjectTask : creates


' =====================================================
' TASK ASSIGNMENT
' =====================================================

ProjectTask "1" -- "0..*" TaskAssignment : assignments

Employee "1" -- "0..*" TaskAssignment : receives


' =====================================================
' COMMENTS
' =====================================================

ProjectTask "1" -- "0..*" Comment : comments

Comment "0..1" -- "0..*" Comment : replies


' =====================================================
' GROUP CHAT
' =====================================================

ApplicationUser "1" -- "0..*" GroupChat : creates

GroupChat "1" -- "0..*" GroupMember : members

Employee "1" -- "0..*" GroupMember : joins


' =====================================================
' MESSAGES
' =====================================================

GroupChat "0..1" -- "0..*" Message : messages

Message "0..1" -- "0..*" Message : replies


' =====================================================
' SUBSCRIPTION / PAYMENT
' =====================================================

SubscriptionPlan "1" -- "0..*" Payment : used for


' =====================================================
' UNIQUE CONSTRAINTS
' =====================================================

note right of ProjectMember
Unique:
ProjectId + EmployeeId

An employee cannot join
the same project twice.
end note

note right of TaskAssignment
Unique:
ProjectTaskId + EmployeeId

The same task cannot be
assigned twice to the
same employee.
end note

note right of GroupMember
Unique:
GroupChatId + EmployeeId

An employee cannot join
the same group twice.
end note

@enduml