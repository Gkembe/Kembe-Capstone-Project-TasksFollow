@model TasksFollow.Models.ProjectTask

@{
    ViewData["Title"] = "Task Details";
    Layout = "_ManagerLayout";
}

<div class="manager-index-page">

    <!-- Header -->
    <div class="manager-page-header">
        <div>
            <h2>Task Details</h2>
            <p>@Model.Project?.Name</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>

    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Task Details -->
    <div class="manager-details-card mb-4">

        <div class="manager-details-header">
            <div class="manager-form-icon"><i class="bi bi-list-task"></i></div>
            <div class="flex-grow-1">
                <h4>@Model.Title</h4>
                <p>@Model.Project?.Name</p>
            </div>

            @if (Model.Status == "Completed")
            {
                <span class="manager-status manager-status-active"><i class="bi bi-circle-fill" style="color:green; font-size:20px"></i> Completed</span>
            }
            else if (Model.Status == "In Progress")
            {
                <span class="manager-status manager-status-progress"><i class="bi bi-circle-fill" style="color:yellow; font-size:15px"></i> In Progress</span>
            }
            else
            {
                <span class="manager-status manager-status-pending"><i class="bi bi-circle-fill" style="color:blue"></i> @Model.Status</span>
            }
        </div>

        <!-- Description -->
        <div class="manager-project-description">
            <h5><i class="bi bi-card-text me-2"></i>Task Description</h5>
            <p>@Model.Description</p>
        </div>

        <!-- Task Information -->
        <div class="manager-details-grid">

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-folder"></i></div>
                <div>
                    <span class="manager-detail-label">Project</span>
                    <p class="manager-detail-value">@Model.Project?.Name</p>
                </div>
            </div>

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-flag"></i></div>
                <div>
                    <span class="manager-detail-label">Priority</span>
                    <p class="manager-detail-value">
                        @if (Model.Priority == "High")
                        {
                            <span class="manager-priority manager-priority-high"><i class="bi bi-flag-fill me-1"></i> High</span>
                        }
                        else if (Model.Priority == "Medium")
                        {
                            <span class="manager-priority manager-priority-medium"><i class="bi bi-flag-fill me-1"></i> Medium</span>
                        }
                        else
                        {
                            <span class="manager-priority manager-priority-low"><i class="bi bi-flag-fill me-1"></i> @Model.Priority</span>
                        }
                    </p>
                </div>
            </div>

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-calendar-event"></i></div>
                <div>
                    <span class="manager-detail-label">Start Date</span>
                    <p class="manager-detail-value">@(Model.StartDate?.ToString("MMM dd, yyyy") ?? "Not Set")</p>
                </div>
            </div>

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-calendar-check"></i></div>
                <div>
                    <span class="manager-detail-label">Due Date</span>
                    <p class="manager-detail-value">@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "Not Set")</p>
                </div>
            </div>

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-person"></i></div>
                <div>
                    <span class="manager-detail-label">Created By</span>
                    <p class="manager-detail-value">@Model.CreatedByUser.FirstName @Model.CreatedByUser.LastName</p>
                </div>
            </div>

            <div class="manager-detail-item">
                <div class="manager-detail-icon"><i class="bi bi-calendar-plus"></i></div>
                <div>
                    <span class="manager-detail-label">Created Date</span>
                    <p class="manager-detail-value">@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>

        </div>

        <!-- Progress -->
        <div class="manager-task-progress-section">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5><i class="bi bi-bar-chart me-2"></i>Task Progress</h5>
                <strong>@Model.Percent%</strong>
            </div>
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width:@(Math.Clamp(Model.Percent, 0, 100))%" aria-valuenow="@Model.Percent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="manager-details-footer">
            <a asp-action="Edit" asp-route-id="@Model.ProjectTaskId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit Task</a>
            <a asp-action="Assignments" asp-route-id="@Model.ProjectTaskId" class="btn btn-outline-primary"><i class="bi bi-people me-1"></i> Manage Assignments</a>
        </div>

    </div>

    <!-- Assigned Employees -->
    <div class="manager-table-card">
        <div class="manager-table-header">
            <div>
                <h4><i class="bi bi-people me-2"></i>Assigned Employees</h4>
                <p>Employees currently assigned to this task.</p>
            </div>
            <span class="manager-count">@Model.TaskAssignments.Count Employees</span>
        </div>

        @if (Model.TaskAssignments.Any())
        {
            <div class="table-responsive">
                <table class="table manager-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Job Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.TaskAssignments)
                        {
                            <tr>
                                <td>
                                    <div class="manager-table-name">
                                        <div class="manager-table-icon"><i class="bi bi-person"></i></div>
                                        <span class="manager-name-link">@assignment.Employee.ApplicationUser.FirstName @assignment.Employee.ApplicationUser.LastName</span>
                                    </div>
                                </td>
                                <td>@assignment.Employee.JobTitle</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="manager-empty-state">
                <div class="manager-empty-icon"><i class="bi bi-people"></i></div>
                <h5>No Assigned Employees</h5>
                <p>No employees have been assigned to this task yet.</p>
                <a asp-action="Assignments" asp-route-id="@Model.ProjectTaskId" class="btn btn-primary mt-3"><i class="bi bi-person-plus me-1"></i> Manage Assignments</a>
            </div>
        }
    </div>

</div>
