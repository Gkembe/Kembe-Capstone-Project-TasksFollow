@model IEnumerable<TasksFollow.Models.Company>

@{
    ViewData["Title"] = "Companies";
    Layout = "_AdminLayout";
}

<div class="company-index-page">
    <div class="company-index-header">
        <div>
            <h1>Companies</h1>
            <p>Manage companies registered in TasksFollow.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary company-add-btn"><i class="bi bi-plus-lg me-1"></i> Add Company</a>
    </div>

    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>All Companies</h4>
                <p>View and manage your registered companies.</p>
            </div>
            <div class="company-count">@Model.Count() Companies</div>
        </div>

        <div class="table-responsive">
            <table class="table company-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-building"></i></div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@item.CompanyId" class="company-name-link">@item.Name</a>

                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <span class="company-description-preview">@item.Description</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        @item.Phone
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        @item.Email
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        @item.Address
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td class="text-nowrap">@item.CreatedDate.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="company-status company-status-active"><i class="bi bi-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="company-status company-status-inactive"><i class="bi bi-circle-fill"></i> Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="company-table-actions">
                                        <a asp-action="Edit" asp-route-id="@item.CompanyId" class="company-action-btn company-action-edit" title="Edit Company"><i class="bi bi-pencil"></i></a>

                                        @if (item.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@item.CompanyId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Deactivate"><i class="bi bi-slash-circle"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate" asp-route-id="@item.CompanyId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success" title="Activate"><i class="bi bi-check-circle"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="company-empty-state">
                                    <div class="company-empty-icon"><i class="bi bi-buildings"></i></div>
                                    <h5>No companies yet</h5>
                                    <p>Create your first company to get started.</p>
                                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Company</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>