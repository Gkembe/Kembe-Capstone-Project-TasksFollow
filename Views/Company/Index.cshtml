@model IEnumerable<TasksFollow.Models.Company>

@{
    ViewData["Title"] = "Companies";
    Layout = "_AdminLayout";
}

<div class="company-index-page">

    <!-- PAGE HEADER -->
    <div class="company-index-header">

        <div>
            <h1>Companies</h1>

            <p>
                Manage companies registered in TasksFollow.
            </p>
        </div>


        <a asp-action="Create"
           class="btn btn-primary company-add-btn">

            <i class="bi bi-plus-lg me-1"></i>
            Add Company

        </a>

    </div>


    <!-- COMPANY TABLE CARD -->
    <div class="company-table-card">

        <!-- CARD HEADER -->
        <div class="company-table-header">

            <div>

                <h4>All Companies</h4>

                <p>
                    View and manage your registered companies.
                </p>

            </div>

            <div class="company-count">
                @Model.Count() Companies
            </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

            <table class="table company-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            Company
                        </th>

                        <th>
                            Phone
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Address
                        </th>

                        <th>
                            Created
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- COMPANY -->
                                <td>

                                    <div class="company-table-name">

                                        <div class="company-table-icon">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div>

                                            <a asp-action="Details"
                                               asp-route-id="@item.CompanyId"
                                               class="company-name-link">

                                                @item.Name

                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <span class="company-description-preview">
                                                    @item.Description
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- PHONE -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        @item.Phone
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- EMAIL -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        @item.Email
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ADDRESS -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        @item.Address
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- CREATED DATE -->
                                <td class="text-nowrap">

                                    @item.CreatedDate.ToString("MMM dd, yyyy")

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="company-status company-status-active">

                                            <i class="bi bi-circle-fill"></i>
                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="company-status company-status-inactive">

                                            <i class="bi bi-circle-fill"></i>
                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="company-table-actions">

                                        


                                        <!-- EDIT -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.CompanyId"
                                           class="company-action-btn company-action-edit"
                                           title="Edit Company">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- DELETE -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.CompanyId"
                                           class="company-action-btn company-action-delete"
                                           title="Delete Company">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- EMPTY STATE -->
                        <tr>

                            <td colspan="7">

                                <div class="company-empty-state">

                                    <div class="company-empty-icon">
                                        <i class="bi bi-buildings"></i>
                                    </div>

                                    <h5>No companies yet</h5>

                                    <p>
                                        Create your first company to get started.
                                    </p>

                                    <a asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-1"></i>
                                        Add Company

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>