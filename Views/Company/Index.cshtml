@model IEnumerable<TasksFollow.Models.Company>

@{
    ViewData["Title"] = "Companies";
    Layout = "_AdminLayout";
}

<div class="company-index-page">
    <!-- Page header -->
    <div class="company-index-header">
        <div>
            <h1>Companies</h1>
            <p>Manage companies registered in TasksFollow.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary company-add-btn"><i class="bi bi-plus-lg me-1"></i> Add Company</a>
    </div>

    <!-- Company list -->
    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>Companies</h4>
                <p>View and manage your registered companies.</p>
            </div>
            <div class="company-count">@Model.Count() Companies</div>
        </div>

        <!-- Search companies by name and filter by status -->
        <form asp-action="Index" method="get" class="row g-3 px-3 pb-3">
            <div class="col-md-6">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search company by name..." id="searchIn" />
            </div>

            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                    <option value="All" selected="@(ViewBag.Status == "All")">All Companies</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>

        <!-- Company table -->
        <div class="table-responsive">
            <table class="table company-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="allRow">
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-building"></i></div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@item.CompanyId" class="company-name-link">@item.Name</a>

                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        @item.Phone
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        @item.Email
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        @item.Address
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td class="text-nowrap">@item.CreatedDate.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="company-status company-status-active"><i class="bi bi-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="company-status company-status-inactive"><i class="bi bi-circle-fill"></i> Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="company-table-actions">
                                        <!-- Edit company information -->
                                        <a asp-action="Edit" asp-route-id="@item.CompanyId" class="company-action-btn company-action-edit" title="Edit Company"><i class="bi bi-pencil"></i></a>

                                        @if (item.IsActive)
                                        {
                                            <!-- Deactivate an active company -->
                                            <form asp-action="Deactivate" asp-route-id="@item.CompanyId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="Deactivate"><i class="bi bi-slash-circle"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- Reactivate an inactive company -->
                                            <form asp-action="Activate" asp-route-id="@item.CompanyId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="Activate"><i class="bi bi-check-circle"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="company-empty-state">
                                    <div class="company-empty-icon"><i class="bi bi-buildings"></i></div>
                                    <h5>No companies found</h5>
                                    <p>No companies match your search or selected status.</p>
                                    <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-clockwise me-1"></i> Reset Filters</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}