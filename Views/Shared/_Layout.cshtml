
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TasksFollow</title>
    @await RenderSectionAsync("Styles", required: false)
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <!-- Application styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TasksFollow.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- Public navigation bar -->
    <header>
        <nav class="navbar navbar-expand-lg home-navbar">
            <div class="container">

                <!-- Application logo -->
                <a class="navbar-brand home-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-check2-square me-2"></i>TasksFollow
                </a>

                <!-- Mobile navigation toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#homeNavbar" aria-controls="homeNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation links -->
                <div class="collapse navbar-collapse" id="homeNavbar">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How It Works</a>
                        </li>
                    </ul>

                    <!-- Login button -->
                    <div class="home-navbar-actions">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary home-login-btn">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main page content uses the full screen width -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- JavaScript libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Optional scripts from individual pages -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
