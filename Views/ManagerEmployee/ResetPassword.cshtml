@model TasksFollow.Models.Employee

@{
    ViewData["Title"] = "Reset Employee Password";
    Layout = "_ManagerLayout";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2><i class="bi bi-shield-lock me-2"></i>Reset Employee Password</h2>
        <p class="text-muted">Send a secure password reset link to this employee.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h5 class="mb-3">Employee Information</h5>

            <p><strong>Name:</strong> @Model.ApplicationUser.FirstName @Model.ApplicationUser.LastName</p>
            <p><strong>Email:</strong> @Model.ApplicationUser.Email</p>
            <p><strong>Department:</strong> @Model.Department</p>

            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                The employee will receive an email with a secure link to create a new password.
            </div>

            <form asp-action="ResetPasswordConfirmed" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.EmployeeId" />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-envelope me-1"></i>Send Reset Link
                </button>

                <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
