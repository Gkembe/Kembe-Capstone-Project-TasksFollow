@model TasksFollow.Models.ProjectTask

@{
    ViewData["Title"] = "Task Details";
    Layout = "_EmployeeLayout";
}

<div class="employee-index-page">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Task Details</h2>
            <p class="text-muted">View task information and collaborate with your team.</p>
        </div>
        <a asp-action="AllTasks" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i> Back to All Tasks
        </a>
    </div>

    <!-- Task Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <!-- Task Title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1">@Model.Title</h4>
                    <p class="text-muted mb-0">Project: @Model.Project.Name</p>
                </div>
                <span class="badge bg-primary">@Model.Status</span>
            </div>

            <!-- Task Details -->
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted small">Priority</label>
                    <p class="fw-semibold">@Model.Priority</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Status</label>
                    <p class="fw-semibold">@Model.Status</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Created Date</label>
                    <p class="fw-semibold">@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Due Date</label>
                    <p class="fw-semibold">@Model.DueDate?.ToString("MMM dd, yyyy")</p>
                </div>

            </div>

            <!-- Task Description -->
            <div class="mt-3">
                <h5>Description</h5>
                <p style="white-space:pre-wrap; overflow-wrap:anywhere">@Model.Description</p>
            </div>

        </div>
    </div>

    <!-- Assignment Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5><i class="bi bi-person-check me-2"></i>Assignment Information</h5>

            @if (ViewBag.IsAssigned == true)
            {
                <p class="text-success mb-0">
                    <i class="bi bi-check-circle me-1"></i> This task is assigned to you.
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    <i class="bi bi-info-circle me-1"></i> This task is not assigned to you. You can view and comment, but cannot update its progress or status.
                </p>
            }
        </div>
    </div>

    <!-- Task Comments -->
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="bi bi-chat-dots me-2"></i>Task Discussion</h5>
                    <p class="text-muted mb-0">Read comments, ask questions, and collaborate with your colleagues.</p>
                </div>
                <a asp-action="Comments" asp-route-id="@Model.ProjectTaskId" class="btn btn-primary">
                    <i class="bi bi-chat-dots me-1"></i> View Comments
                </a>
            </div>
        </div>
    </div>

</div>
