@model IEnumerable<TasksFollow.Models.Project>

@{

    ViewData["Title"] = "My Projects";

    Layout = "_EmployeeLayout";
}

<div class="container-fluid py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>My Projects</h2>

            <p class="text-muted mb-0">View projects you are participating in.</p>

        </div>

        <span class="badge bg-primary">@Model.Count() Projects</span>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h5 class="mb-3"><i class="bi bi-funnel"></i> Search & Filters</h5>

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">Search Project</label>

                        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Project name or description..." />
                    </div>

                    <div class="col-md-4">

                        <label class="form-label">Status</label>

                        <select name="status" class="form-select">

                            <option value="" selected="@(ViewBag.Status == "")">All Statuses</option>
                            <option value="Not Started" selected="@(ViewBag.Status == "Not Started")">Not Started</option>
                            <option value="In Progress" selected="@(ViewBag.Status == "In Progress")">In Progress</option>
                            <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>

                        </select>

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button class="btn btn-primary w-100" type="submit"><i class="bi bi-search"></i> Search</button>

                    </div>

                    <div class="col-12">


                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="mb-3">Project List</h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@project.Name</strong>
                                   
                                </td>
                                <td>
                                    @if (project.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (project.Status == "In Progress")
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@project.Status</span>
                                    }
                                </td>
                                <td>@(project.StartDate?.ToString("MMM dd, yyyy") ?? "—")</td>

                                <td>@(project.DueDate?.ToString("MMM dd, yyyy") ?? "—")</td>

                                <td>
                                    <a asp-action="Details" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-4">

                    <i class="bi bi-folder fs-1 text-muted"></i>

                    <h5 class="mt-2">No Projects Found</h5>

                    <p class="text-muted">No projects match your selected filters.</p>
                </div>
            }
        </div>
    </div>
</div>
