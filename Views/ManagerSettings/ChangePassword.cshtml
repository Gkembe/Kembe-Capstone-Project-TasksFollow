@model TasksFollow.Models.ManagerChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_ManagerLayout";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2><i class="bi bi-shield-lock me-2"></i>Change Password</h2>
        <p class="text-muted">Update your account password securely.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="ChangePassword" method="post" id="changePasswordForm" >

                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label><span id="currentPasswordStart"></span>
                    <input asp-for="CurrentPassword" id="currentPassword" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label><span id="newPasswordStart"></span>
                    <input asp-for="NewPassword" id="newPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label><span id="confirmPasswordStart"></span>
                    <input asp-for="ConfirmPassword" id="confirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Update Password</button>
                    <a asp-action="Profile" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Profile</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/changePassword.js" asp-append-version="true"></script>
}