@model TasksFollow.Models.CreateGroupViewModel

@{
    ViewData["Title"] = "Create Group";
    Layout = "_ManagerLayout";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Create Group</h2>
            <p class="text-muted mb-0">Create a conversation and add employees from your company.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Messages
        </a>
    </div>

    <!-- Create Group Form -->
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Group Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Group Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter group name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>

                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the purpose of this group"></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Select Employees -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Select Employees</label>

                    <p class="text-muted small">Choose the employees who will participate in this conversation.</p>

                    <div class="border rounded p-3" style="max-height:300px; overflow-y:auto;">

                        @if (Model.Employees.Any())
                        {
                            @foreach (var employee in Model.Employees)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedEmployeeIds" value="@employee.Value" id="employee-@employee.Value" checked="@Model.SelectedEmployeeIds.Contains(int.Parse(employee.Value))" />
                                    <label class="form-check-label" for="employee-@employee.Value">@employee.Text</label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No active employees available.</p>
                        }
                    </div>
                    <span asp-validation-for="SelectedEmployeeIds" class="text-danger"></span>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i> Create Group
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
