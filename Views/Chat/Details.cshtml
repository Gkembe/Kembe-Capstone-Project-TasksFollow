@model TasksFollow.Models.GroupChat
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Name;

    // Display the correct layout based on the logged-in user's role
    Layout = User.IsInRole("Manager") ? "_ManagerLayout" : "_EmployeeLayout";

    // Get the logged-in user's ID to identify their own messages
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<!-- Load the CSS styles for the group conversation page -->
<link rel="stylesheet" href="~/css/groupchat.css" asp-append-version="true" />

<div class="group-chat-page">

    <!-- Page Header: Display group information and navigation buttons -->
    <div class="group-chat-header">
        <div>
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
        </div>

        <div class="group-chat-actions">
            <!-- Only managers can add or remove group members -->
            @if (User.IsInRole("Manager"))
            {
                <!-- Manage group members -->
                <a asp-action="ManageMembers" asp-route-id="@Model.GroupChatId" class="btn btn-outline-primary">
                    <i class="bi bi-people me-1"></i> Manage Members
                </a>

                <!-- Only managers can delete groups -->
                <a asp-action="Delete" asp-route-id="@Model.GroupChatId" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete Group
                </a>
            }


            <a asp-action="Index" class="back-btn">
                <i class="bi bi-arrow-left me-1"></i> Back to Messages
            </a>
        </div>
    </div>

    <!-- Notifications: Display success or error messages after an action -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Conversation Card: Contains message history and the message form -->
    <div class="group-chat-card">

        <!-- Conversation Header -->
        <div class="group-chat-card-header">
            <div class="group-chat-header-icon"><i class="bi bi-chat-dots"></i></div>
            <div>
                <h2 style="color:black">@Model.Name</h2>

                <h5>Conversation</h5>

                <span>Group Messages</span>
            </div>
        </div>

        <!-- Message History: Display messages in the order provided by the controller -->
        <div class="group-chat-messages" id="chatMessages">

            @if (Model.Messages.Any())
            {
                @foreach (var message in Model.Messages)
                {
                    // Check whether the current user is the sender of this message
                    bool isMine = message.UserId == currentUserId;

                    // Align the user's own messages to the right and others to the left
                    <div class="chat-message-row @(isMine ? "mine" : "other")">

                        <!-- Message Bubble: Blue for current user, light gray for others -->
                        <div class="chat-message-bubble">

                            <!-- Sender Name and Message Date -->
                            <div class="chat-message-info">
                                <strong>@message.User.FirstName @message.User.LastName</strong>
                                <small>@message.SentDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>

                            <!-- Message Content: Preserve line breaks entered by the sender -->
                            <p class="chat-message-content">@message.Content</p>

                            <!-- Edited Indicator: Show when the message has been modified -->
                            @if (message.EditedDate.HasValue)
                            {
                                <small class="chat-message-edited">
                                    <i class="bi bi-pencil me-1"></i> Edited
                                </small>
                            }

                            <!-- Message Actions: Only the sender can edit or delete their message -->
                            @if (isMine)
                            {
                                <div class="chat-message-actions">

                                    <!-- Edit Message: Open the message editing page -->
                                    <a asp-action="EditMessage" asp-route-id="@message.MessageId">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>

                                    <!-- Delete Message: Submit a secure POST request -->
                                    <form asp-action="DeleteMessage" asp-route-id="@message.MessageId" method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" onclick="return confirm('Are you sure you want to delete this message?');">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty Conversation: Display when the group has no messages -->
                <div class="chat-empty">
                    <i class="bi bi-chat-dots"></i>
                    <p>No messages yet. Start the conversation!</p>
                </div>
            }
        </div>

        <!-- Send Message Form: Available to authorized group participants -->
        <div class="group-chat-footer">
            <form asp-action="SendMessage" method="post">
                @Html.AntiForgeryToken()

                <!-- Identify the group receiving this message -->
                <input type="hidden" name="groupChatId" value="@Model.GroupChatId" />

                <div class="group-chat-form">

                    <!-- Message Input: Maximum 3000 characters -->
                    <textarea name="content" rows="2" maxlength="3000"
                              placeholder="Type your message..." required></textarea>

                    <!-- Send Button -->
                    <button type="submit" class="group-chat-send-btn"><i class="bi bi-send"></i><span>Send</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Automatically scroll to the most recent message when the page loads -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Get the conversation container
        var chat = document.getElementById("chatMessages");

        // Scroll to the bottom so the newest message is visible
        if (chat) {
            chat.scrollTop = chat.scrollHeight;
        }
    });
</script>
