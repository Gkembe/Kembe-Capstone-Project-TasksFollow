@model TasksFollow.Models.GroupChat

@{
    ViewData["Title"] = "Delete Group";
    Layout = "_ManagerLayout";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2>Delete Group</h2>
        <p class="text-muted">Confirm that you want to delete this conversation group.</p>
    </div>

    <!-- Delete Confirmation -->
    <div class="border rounded p-4">

        <h5>@Model.Name</h5>

        <p class="text-muted">@Model.Description</p>

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Are you sure you want to delete this group? Members will no longer be able to access the conversation.
        </div>

        <!-- Submit deletion using POST -->
        <form asp-action="Delete" asp-route-id="@Model.GroupChatId" method="post">
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete Group</button>

            <a asp-action="Details" asp-route-id="@Model.GroupChatId" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
