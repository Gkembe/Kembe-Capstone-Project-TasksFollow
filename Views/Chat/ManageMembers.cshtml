@model TasksFollow.Models.ManageGroupMembersViewModel

@{
    ViewData["Title"] = "Manage Group Members";
    Layout = "_ManagerLayout";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Group Members</h2>
            <p class="text-muted mb-0">@Model.GroupName</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.GroupChatId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Conversation
        </a>
    </div>

    <!-- Members Form -->
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="ManageMembers" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="GroupChatId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5>Select Employees</h5>
                <p class="text-muted">Check employees to add them to this conversation. Uncheck employees to remove them.</p>

                <div class="border rounded p-3 mb-4" style="max-height:350px; overflow-y:auto;">
                    @if (Model.Employees.Any())
                    {
                        @foreach (var employee in Model.Employees)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="SelectedEmployeeIds" value="@employee.Value" id="employee-@employee.Value" checked="@Model.SelectedEmployeeIds.Contains(int.Parse(employee.Value))" />
                                
                                <label class="form-check-label" for="employee-@employee.Value">@employee.Text</label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active employees available.</p>
                    }
                </div>

                <span asp-validation-for="SelectedEmployeeIds" class="text-danger"></span>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Save Members</button>

                    <a asp-action="Details" asp-route-id="@Model.GroupChatId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
