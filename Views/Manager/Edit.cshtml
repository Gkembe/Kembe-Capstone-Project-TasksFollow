@model TasksFollow.Models.ManagerEditViewModel

@{
	ViewData["Title"] = "Edit Manager";
	Layout = "_AdminLayout";
}

<div class="container-fluid">

	<!-- HEADER -->
	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h2 class="mb-1">Edit Manager</h2>
			<p class="text-muted mb-0">Update manager information and company assignment</p>
		</div>

		<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>

	</div>


	<!-- EDIT CARD -->
	<div class="card border-0 shadow-sm">

		<div class="card-body p-4">

			<form asp-action="Edit" method="post" id="editManagerForm">

				<input type="hidden" asp-for="Id" />

				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>


				<!-- PERSONAL INFORMATION -->

				<h5 class="mb-3">
					<i class="bi bi-person-vcard me-2"></i>
					Personal Information
				</h5>

				<div class="row">

					<!-- FIRST NAME -->
					<div class="col-md-6 mb-3">

						<label asp-for="FirstName" class="form-label"></label><span id="firstNameStart"></span>
						<input asp-for="FirstName" id="firstName" class="form-control" />
						<span asp-validation-for="FirstName" class="text-danger"></span>

					</div>


					<!-- LAST NAME -->
					<div class="col-md-6 mb-3">

						<label asp-for="LastName" class="form-label"></label><span id="lastNameStart"></span>
						<input asp-for="LastName" id="lastName" class="form-control" />
						<span asp-validation-for="LastName" class="text-danger"></span>

					</div>


					<!-- MIDDLE NAME -->
					<div class="col-md-6 mb-3">

						<label asp-for="MiddleName" class="form-label"></label><span id="middleNameStart"></span>
						<input asp-for="MiddleName" id="middleName" class="form-control" />
						<span asp-validation-for="MiddleName" class="text-danger"></span>

					</div>


					<!-- EMAIL -->
					<div class="col-md-6 mb-3">

						<label asp-for="Email" class="form-label"></label><span id="emailStart"></span>
						<input asp-for="Email" id="email" class="form-control" />
						<span asp-validation-for="Email" class="text-danger"></span>

					</div>


					<!-- PHONE -->
					<div class="col-md-6 mb-3">

						<label asp-for="PhoneNumber" class="form-label"></label><span id="phoneStart"></span>
						<input asp-for="PhoneNumber" id="phone" class="form-control" />
						<span asp-validation-for="PhoneNumber" class="text-danger"></span>

					</div>

				</div>


				<hr class="my-4" />


				<!-- COMPANY -->

				<h5 class="mb-3"><i class="bi bi-building me-2"></i>Company Assignment</h5>

				<div class="row">

					<div class="col-md-6 mb-3">

						<label asp-for="CompanyId" class="form-label">Company</label><span id="companyStart"></span>

						<select asp-for="CompanyId" asp-items="Model.Companies" class="form-select" id="companyId">

							<option value="">Select Company</option>

						</select>

						<span asp-validation-for="CompanyId" class="text-danger"></span>

					</div>

				</div>


				<hr class="my-4" />


				<!-- BUTTONS -->

				<div class="d-flex gap-2">

					<button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes </button>

					<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>

				</div>

			</form>

		</div>

	</div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/editManager.js" asp-append-version="true"></script>
}
