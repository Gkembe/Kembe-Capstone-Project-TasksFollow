@model TasksFollow.Models.ManagerDetailsViewModel

@{
    ViewData["Title"] = "Manager Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Manager Details</h2>
            <p class="text-muted mb-0">
                View manager and company information.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>

    </div>


    <!-- MANAGER CARD -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- MANAGER NAME -->
            <div class="d-flex align-items-center mb-4">

                <div class="manager-icon me-3">
                    <i class="bi bi-person"></i>
                </div>

                <div>
                    <h4 class="mb-1">
                        @Model.FirstName

                        @if (!string.IsNullOrEmpty(Model.MiddleName))
                        {
                            @Model.MiddleName
                        }

                        @Model.LastName
                    </h4>

                    <span class="badge bg-primary">Manager</span>
                </div>

            </div>


            <hr />


            <!-- PERSONAL INFORMATION -->
            <h5 class="mb-3">
                <i class="bi bi-person-vcard me-2"></i>Personal Information</h5>

            <div class="row mb-4">

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">First Name</small>
                    <strong>@Model.FirstName</strong>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Last Name</small>
                    <strong>@Model.LastName</strong>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Middle Name</small>

                    @if (!string.IsNullOrEmpty(Model.MiddleName))
                    {
                        <strong>@Model.MiddleName</strong>
                    }
                    else
                    {
                        <strong>Not provided</strong>
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Email</small>
                    <strong>@Model.Email</strong>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Phone Number</small>

                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <strong>@Model.PhoneNumber</strong>
                    }
                    else
                    {
                        <strong>Not provided</strong>
                    }

                </div>

            </div>


            <hr />


            <!-- COMPANY -->
            <h5 class="mb-3"><i class="bi bi-building me-2"></i>Company Information</h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Company Name</small>
                    <strong>@Model.CompanyName</strong>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Company Status</small>

                    @if (Model.CompanyIsActive)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            <i class="bi bi-slash-circle me-1"></i>
                            Inactive
                        </span>
                    }

                </div>

            </div>


            <hr />


            <!-- BUTTONS -->
            <div class="d-flex gap-2">

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>

                @if (Model.CompanyId != null)
                {
                    <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-outline-secondary"><i class="bi bi-building me-1"></i>View Company</a>
                }

            </div>

        </div>

    </div>

</div>
