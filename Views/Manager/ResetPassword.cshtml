@model TasksFollow.Models.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Manager Password";
    Layout = "_AdminLayout";
}

<div class="company-create-page">

    <!-- Page header -->
    <div class="company-page-header">
        <div>
            <h1>Reset Password</h1>
            <p>Reset the password for @Model.ManagerName.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.ManagerId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <div class="company-form-card">
        <div class="company-form-header">
            <div class="company-form-icon"><i class="bi bi-shield-lock"></i></div>
            <div>
                <h4>Reset Manager Password</h4>
                <p>Enter a new password for this manager account.</p>
            </div>
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ManagerId" />
            <input type="hidden" asp-for="ManagerName" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Manager name -->
            <div class="mb-3">
                <label class="form-label">Manager</label>
                <input value="@Model.ManagerName" class="form-control" disabled />
            </div>

            <!-- New password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- Confirm password -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Form actions -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    Reset Password
                </button>
                <a asp-action="Details" asp-route-id="@Model.ManagerId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
