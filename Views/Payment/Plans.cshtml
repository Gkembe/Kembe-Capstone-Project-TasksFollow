@model IEnumerable<TasksFollow.Models.SubscriptionPlan>

@{
    ViewData["Title"] = "Subscription Plans";
    Layout = "_AdminLayout";
}

<div class="company-index-page">
    <div class="company-index-header">
        <div>
            <h1>Subscription Plans</h1>
            <p>Manage subscription plans available in TasksFollow.</p>
        </div>
        <a asp-action="CreatePlan" class="btn btn-primary company-add-btn"><i class="bi bi-plus-lg me-1"></i> Add Plan</a>
    </div>

    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>All Subscription Plans</h4>
                <p>View and manage your available subscription plans.</p>
            </div>
            <div class="company-count">@Model.Count() Plans</div>
        </div>

        <div class="table-responsive">
            <table class="table company-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Plan Name</th>
                        <th>Monthly Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var plan in Model)
                        {
                            <tr>
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-credit-card"></i></div>
                                        <div>
                                            <span class="company-name-link">@plan.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                                            {
                                                <span class="company-description-preview">@plan.Description</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (plan.MonthlyPrice.HasValue)
                                    {
                                        <strong>$@plan.MonthlyPrice.Value.ToString("0.00")</strong>
                                        <span class="company-empty-value"> / month</span>
                                    }
                                    else
                                    {
                                        <span class="company-empty-value">—</span>
                                    }
                                </td>

                                <td>
                                    @if (plan.IsActive)
                                    {
                                        <span class="company-status company-status-active"><i class="bi bi-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="company-status company-status-inactive"><i class="bi bi-circle-fill"></i> Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="company-table-actions">
                                        <a asp-action="EditPlan" asp-route-id="@plan.SubscriptionPlanId" class="company-action-btn company-action-edit" title="Edit Plan"><i class="bi bi-pencil"></i></a>

                                        @if (plan.IsActive)
                                        {
                                            <form asp-action="DeactivatePlan" asp-route-id="@plan.SubscriptionPlanId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Deactivate Plan"><i class="bi bi-slash-circle"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivatePlan" asp-route-id="@plan.SubscriptionPlanId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success" title="Activate Plan"><i class="bi bi-check-circle"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="company-empty-state">
                                    <div class="company-empty-icon"><i class="bi bi-credit-card"></i></div>
                                    <h5>No subscription plans yet</h5>
                                    <p>Create your first subscription plan to get started.</p>
                                    <a asp-action="CreatePlan" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Plan</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>