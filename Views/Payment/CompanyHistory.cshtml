@model IEnumerable<TasksFollow.Models.Payment>

@{
    ViewData["Title"] = "Payment History";
    Layout = "_AdminLayout";
}

<div class="company-index-page">
    <div class="company-index-header">
        <div>
            <h1>Payment History</h1>
            <p>View all payments for @ViewBag.CompanyName.</p>
        </div>

        <div class="payment-header-actions">
            <a asp-controller="Payment" asp-action="Create" asp-route-companyId="@ViewBag.CompanyId" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Payment</a>
            <a asp-controller="Company" asp-action="Details" asp-route-id="@ViewBag.CompanyId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
    </div>

    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>@ViewBag.CompanyName</h4>
                <p>Company payment history.</p>
            </div>
            <div class="company-count">@Model.Count() Payments</div>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table company-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th>Amount Paid</th>
                            <th>Monthly Price</th>
                            <th>Months</th>
                            <th>Payment Date</th>
                            <th>Coverage Start</th>
                            <th>Coverage End</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-tags"></i></div>
                                        <span class="payment-plan-name">@payment.SubscriptionPlan.Name</span>
                                    </div>
                                </td>

                                <td><strong>$@payment.AmountPaid.ToString("0.00")</strong></td>

                                <td>$@payment.MonthlyPrice.ToString("0.00")</td>

                                <td>@payment.MonthsPaid</td>

                                <td class="text-nowrap">@payment.PaymentDate.ToString("MMM dd, yyyy")</td>

                                <td class="text-nowrap">@payment.CoverageStartDate.ToString("MMM dd, yyyy")</td>

                                <td class="text-nowrap">@payment.CoverageEndDate.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @if (payment.CoverageEndDate >= DateTime.Today)
                                    {
                                        <span class="company-status company-status-active"><i class="bi bi-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="company-status company-status-inactive"><i class="bi bi-circle-fill"></i> Expired</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="company-empty-state">
                <div class="company-empty-icon"><i class="bi bi-credit-card"></i></div>
                <h5>No Payments</h5>
                <p>No payments have been recorded for this company.</p>
            </div>
        }
    </div>
</div>