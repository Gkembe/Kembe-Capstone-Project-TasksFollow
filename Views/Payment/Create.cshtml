@model TasksFollow.Models.ViewModels.PaymentCreateViewModel

@{
    ViewData["Title"] = "Add Payment";
    Layout = "_AdminLayout";
}

<div class="company-create-page">
    <div class="company-page-header">
        <div>
            <h1>Add Payment</h1>
            <p>Record a subscription payment for @Model.CompanyName.</p>
        </div>

        <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Company</a>
    </div>

    <div class="company-form-card">
        <div class="company-form-header">
            <div class="company-form-icon"><i class="bi bi-credit-card"></i></div>
            <div>
                <h4>Payment Information</h4>
                <p>Enter the subscription payment details below.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="CompanyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label class="form-label">Company</label>
                <input value="@Model.CompanyName" class="form-control" disabled />
            </div>

            <div class="mb-4">
                <label asp-for="SubscriptionPlanId" class="form-label"></label>
                <select asp-for="SubscriptionPlanId" asp-items="ViewBag.Plans" class="form-select">
                    <option value="">-- Select Plan --</option>
                </select>
                <span asp-validation-for="SubscriptionPlanId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AmountPaid" class="form-label"></label>
                <input asp-for="AmountPaid" type="number" step="0.01" class="form-control" placeholder="Enter amount paid" />
                <span asp-validation-for="AmountPaid" class="text-danger"></span>
            </div>

            <div class="company-form-actions">
                <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-light company-cancel-btn">Cancel</a>
                <button type="submit" class="btn btn-primary company-submit-btn"><i class="bi bi-credit-card me-1"></i> Record Payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}