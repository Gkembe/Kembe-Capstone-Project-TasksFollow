@model IEnumerable<TasksFollow.Models.Payment>

@{
    ViewData["Title"] = "Payments";
    Layout = "_AdminLayout";
}

<div class="company-index-page">

    <!-- Page header -->
    <div class="company-index-header">
        <div>
            <h1>Payments</h1>
            <p>View subscription payments made by companies.</p>
        </div>
    </div>

    <!-- Payment history card -->
    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>Payment History</h4>
                <p>View all company subscription payments.</p>
            </div>
            <div class="company-count">@Model.Count() Payments</div>
        </div>

        <!-- Search payments by company or plan and filter by coverage status and year -->
        <form asp-action="Index" method="get" class="row g-3 px-3 pb-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search company or plan..." id="searchIn"/>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="All" selected="@(ViewBag.Status == "All")">All Payments</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expired</option>
                </select>
            </div>

            <div class="col-md-3">
                <input type="number" name="year" value="@ViewBag.Year" class="form-control" placeholder="Payment year" min="2000" max="2100" />
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>

        <!-- Display all payments returned by the controller -->
        <div class="table-responsive">
            <table class="table company-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th>Monthly Price</th>
                        <th>Months</th>
                        <th>Payment Date</th>
                        <th>Coverage Start</th>
                        <th>Coverage End</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var payment in Model)
                        {
                            <tr class="allRow">
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-building"></i></div>
                                        <div>
                                            <!-- Open the company details page -->
                                            <a asp-controller="Company" asp-action="Details" asp-route-id="@payment.CompanyId" class="company-name-link">@payment.Company.Name</a>
                                        </div>
                                    </div>
                                </td>

                                <td>@payment.SubscriptionPlan.Name</td>
                                <td><strong>$@payment.AmountPaid.ToString("0.00")</strong></td>
                                <td>$@payment.MonthlyPrice.ToString("0.00")</td>
                                <td>@payment.MonthsPaid months</td>
                                <td class="text-nowrap">@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-nowrap">@payment.CoverageStartDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-nowrap">@payment.CoverageEndDate.ToString("MMM dd, yyyy")</td>

                                <td>
                                    <!-- Open the payment deletion confirmation page -->
                                    <a asp-controller="Payment" asp-action="Delete" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Display an empty state when no payments match the filters -->
                        <tr>
                            <td colspan="9">
                                <div class="company-empty-state">
                                    <div class="company-empty-icon"><i class="bi bi-credit-card"></i></div>
                                    <h5>No Payments Found</h5>
                                    <p>No payments match your search or selected filters.</p>
                                    <a asp-action="Index" class="btn btn-outline-primary">
                                        <i class="bi bi-arrow-clockwise me-1"></i> Reset Filters
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}