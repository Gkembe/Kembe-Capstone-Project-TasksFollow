@model IEnumerable<TasksFollow.Models.Payment>

@{
    ViewData["Title"] = "Payments";
    Layout = "_AdminLayout";
}

<div class="company-index-page">
    <div class="company-index-header">
        <div>
            <h1>Payments</h1>
            <p>View subscription payments made by companies.</p>
        </div>
    </div>

    <div class="company-table-card">
        <div class="company-table-header">
            <div>
                <h4>Payment History</h4>
                <p>View all company subscription payments.</p>
            </div>
            <div class="company-count">@Model.Count() Payments</div>
        </div>

        <div class="table-responsive">
            <table class="table company-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th>Monthly Price</th>
                        <th>Months</th>
                        <th>Payment Date</th>
                        <th>Coverage Start</th>
                        <th>Coverage End</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>
                                    <div class="company-table-name">
                                        <div class="company-table-icon"><i class="bi bi-building"></i></div>
                                        <div>
                                            <a asp-controller="Company" asp-action="Details" asp-route-id="@payment.CompanyId" class="company-name-link">@payment.Company.Name</a>
                                        </div>
                                    </div>
                                </td>

                                <td>@payment.SubscriptionPlan.Name</td>

                                <td><strong>$@payment.AmountPaid.ToString("0.00")</strong></td>

                                <td>$@payment.MonthlyPrice.ToString("0.00")</td>

                                <td>@payment.MonthsPaid months</td>

                                <td class="text-nowrap">@payment.PaymentDate.ToString("MMM dd, yyyy")</td>

                                <td class="text-nowrap">@payment.CoverageStartDate.ToString("MMM dd, yyyy")</td>

                                <td class="text-nowrap">@payment.CoverageEndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                   
                                        <a asp-controller="Payment" asp-action="Delete" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="company-empty-state">
                                    <div class="company-empty-icon"><i class="bi bi-credit-card"></i></div>
                                    <h5>No payments yet</h5>
                                    <p>Company payments will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>